---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { t, other, url, splitId, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  const ids = new Set(all.map((p) => p.id));
  return all.map((project) => {
    const { lang, slug } = splitId(project.id);
    return { params: { lang, slug }, props: { project, translated: ids.has(`${other(lang)}/${slug}`) } };
  });
}

interface Props { project: CollectionEntry<'projects'>; translated: boolean }
const { project, translated } = Astro.props;
const lang = Astro.params.lang as Lang;
const s = t[lang].projects;
const p = project.data;
const { Content } = await render(project);
const altHref = url(`${other(lang)}/projects/${translated ? `${Astro.params.slug}/` : ''}`);
---

<Base lang={lang} title={p.title} description={p.summary} altHref={altHref}>
  <article class="wrap">
    <header class="head">
      <h1>{p.title}</h1>
      <p class="lede">{p.summary}</p>
      {p.highlight && <p class="highlight">{p.highlight}</p>}
    </header>

    <dl class="spec">
      <div><dt>{s.role}</dt><dd>{p.role}</dd></div>
      <div><dt>{s.where}</dt><dd>{p.org}, {p.place}</dd></div>
      <div><dt>{s.period}</dt><dd>{p.period}</dd></div>
      <div><dt>{s.stack}</dt><dd><ul class="tags">{p.tags.map((tag) => <li>{tag}</li>)}</ul></dd></div>
    </dl>

    <div class="prose"><Content /></div>

    {p.links.length > 0 && (
      <ul class="links">{p.links.map((l) => <li><a class="text-link" href={l.href}>{l.label}</a></li>)}</ul>
    )}

    <p class="back"><a class="text-link" href={url(`${lang}/projects/`)}>{s.back}</a></p>
  </article>
</Base>

<style>
  .head { padding: clamp(2rem, 6vw, 4rem) 0 2rem; border-bottom: 5px solid var(--signal); }
  h1 { font-size: clamp(2.2rem, 5.5vw, 3.8rem); margin-bottom: 1rem; max-width: 22ch; }
  .highlight { color: var(--signal); font-weight: 600; margin: 0; }
  .spec { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1.25rem 2rem; margin: 2rem 0 3rem; }
  .spec dt { font-size: 0.78rem; color: var(--ink-soft); }
  .spec dd { margin: 0.2rem 0 0; font-weight: 500; }
  .links { list-style: none; padding: 0; display: flex; gap: 1.5rem; margin-top: 2rem; }
  .back { margin-top: 4rem; }
</style>
