---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { t, other, url, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Same page in the other language; defaults to swapping the language segment of this URL. */
  altHref?: string;
}

const { lang, title, description, altHref } = Astro.props;
const s = t[lang];
const fullTitle = title ? `${title} | ${s.name}` : s.name;
const alt = altHref ?? Astro.url.pathname.replace(`/${lang}/`, `/${other(lang)}/`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? s.hero.line} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate" hreflang={other(lang)} href={alt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500..700;1,6..96,500&family=Gowun+Batang:wght@400;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+KR:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <Header lang={lang} altHref={alt} />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{s.footer}</p>
        <p>
          <a href="mailto:hyewonj@andrew.cmu.edu">hyewonj@andrew.cmu.edu</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  main { min-height: 70vh; padding-bottom: 6rem; }
  .site-footer { border-top: 1px dashed var(--rule); color: var(--ink-soft); font-size: 0.95rem; padding: 2rem 0 3rem; }
  .site-footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; }
  .site-footer p { margin: 0; }
</style>
